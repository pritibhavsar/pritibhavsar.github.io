---
const faqs = [
  {
    question: 'What kind of AI solutions does PAL Portals build?',
    answer:
      'We design and deliver Generative AI systems end to end — agentic workflows, secure Model Context Protocol (MCP) servers, predictive analytics, knowledge assistants, and marketing copilots — tailored to your business goals.',
  },
  {
    question: 'How do you decide which AI use case to start with?',
    answer:
      'Every engagement starts with a readiness audit. We map candidate use cases against business value, data availability, and risk, then prioritise the opportunities with the clearest path to measurable ROI.',
  },
  {
    question: 'How do you keep our data secure?',
    answer:
      'Security is designed in from day one: governed MCP access, role-based controls, privacy-aware data handling, and deployment patterns aligned with enterprise compliance requirements.',
  },
  {
    question: 'Can you integrate AI with our existing systems?',
    answer:
      'Yes. We specialise in API, cloud, B2B, and hybrid integrations, connecting AI agents to CRMs, data platforms, and operational tools without disrupting day-to-day work.',
  },
  {
    question: 'Do you also build mobile applications?',
    answer:
      'We deliver industry-focused mobile apps for finance, healthcare, eCommerce, and event management, with tailored UX and AI-powered features where they add value.',
  },
  {
    question: 'What does an engagement look like?',
    answer:
      'We follow a Discover → Design → Build → Scale model with transparent milestones, so you always know what is being delivered, why it matters, and how success is measured.',
  },
];
---

<!-- ====== FAQ Section Start -->
<section id="faq" class="section section--alt">
  <div class="section-orb section-orb--violet section-orb--tr" aria-hidden="true"></div>
  <div class="container">
    <div class="-mx-4 flex flex-wrap gap-y-12">
      <div class="w-full px-4 lg:w-5/12">
        <div class="section-header section-header--left lg:sticky lg:top-32">
          <span class="eyebrow">FAQ</span>
          <h2 class="section-title">
            Questions? <span class="text-gradient">We Have Answers</span>
          </h2>
          <p class="section-lead mb-8">
            Everything you need to know about working with PAL Portals. Can't find what you're looking for? Our team is happy to help.
          </p>
          <a href="/contact" class="btn btn-secondary">Ask a Question</a>
        </div>
      </div>

      <div class="w-full px-4 lg:w-7/12">
        <div class="space-y-4">
          {
            faqs.map((faq, index) => (
              <details class="faq-item glass-card wow" open={index === 0} data-wow-delay={`${index * 0.05}s`}>
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <span class="faq-icon" aria-hidden="true"></span>
                </summary>
                <p class="faq-answer card-text">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
<!-- ====== FAQ Section End -->

<style>
  .faq-item {
    height: auto;
    padding: 0;
    box-shadow: var(--shadow-sm);
  }

  .faq-item[open] {
    border-color: var(--color-border-accent);
    box-shadow: var(--shadow-md), var(--shadow-glow);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .faq-question::-webkit-details-marker { display: none; }

  .faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--color-primary-soft);
    transition: background var(--duration-base) ease, transform var(--duration-base) var(--ease-out);
  }

  .faq-icon::before,
  .faq-icon::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-text);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .faq-icon::after { transform: rotate(90deg); }

  .faq-item[open] .faq-icon {
    background: var(--gradient-button);
    transform: rotate(180deg);
  }

  .faq-item[open] .faq-icon::before,
  .faq-item[open] .faq-icon::after { background: #ffffff; }

  .faq-item[open] .faq-icon::after { transform: rotate(0deg); }

  .faq-answer {
    margin: 0;
    padding: 0 var(--space-6) var(--space-6);
  }
</style>

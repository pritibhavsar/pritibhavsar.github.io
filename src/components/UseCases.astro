---
const useCases = [
  {
    image: '/assets/use-cases/usecase-01.svg',
    title: 'AI Customer Support Copilot',
    description:
      'Implemented an omnichannel support copilot that understands intent, drafts accurate replies, and routes complex issues to specialists with full context continuity.',
    outcome: 'Faster response quality with reduced manual effort'
  },
  {
    image: '/assets/use-cases/usecase-02.svg',
    title: 'Demand Forecasting for Supply Chain',
    description:
      'Delivered predictive demand models that combine sales history, seasonal behavior, and operational signals to improve planning and inventory confidence.',
    outcome: 'Lower stockout risk and better inventory control'
  },
  {
    image: '/assets/use-cases/usecase-03.svg',
    title: 'Claims and Document Automation',
    description:
      'Built an AI-assisted claims flow that extracts data from documents, validates key fields, and accelerates decision workflows with policy-aware checks.',
    outcome: 'Reduced processing cycle time and error rates'
  },
  {
    image: '/assets/use-cases/usecase-04.svg',
    title: 'Enterprise Knowledge Assistant',
    description:
      'Created a secure internal assistant that searches policies, SOPs, contracts, and technical docs with role-based controls and source-cited responses.',
    outcome: 'Faster decision support across departments'
  },
  {
    image: '/assets/use-cases/usecase-05.svg',
    title: 'Fraud Risk Detection and Investigation',
    description:
      'Designed a risk-monitoring pipeline that flags anomalies in near real time and supports investigators with case summaries and contextual evidence.',
    outcome: 'Stronger risk governance and quicker triage'
  },
  {
    image: '/assets/use-cases/usecase-06.svg',
    title: 'Marketing Personalization Co-Pilot',
    description:
      'Deployed a campaign copilot that segments audiences, generates channel-specific variants, and recommends launch timing based on engagement patterns.',
    outcome: 'Higher campaign relevance and conversion lift'
  }
];
---

<section id="use-cases" class="section">
  <div class="section-orb section-orb--violet section-orb--tl" aria-hidden="true"></div>
  <div class="section-orb section-orb--cyan section-orb--br" aria-hidden="true"></div>

  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Proven Delivery Portfolio</span>
      <h2 class="section-title">
        Real-World <span class="text-gradient">AI Impact</span> Across Industries
      </h2>
      <p class="section-lead">
        Explore selected delivery scenarios where we combined Generative AI, MCP integration, and enterprise engineering to create measurable business outcomes.
      </p>
    </div>

    <div class="-m-5">
      <div class="swiper usecase-carousel common-carousel p-5">
        <div class="swiper-wrapper">
          {
            useCases.map((item, index) => (
              <div class="swiper-slide">
                <article class="glass-card glass-card--interactive usecase-card flex flex-col">
                  <div class="usecase-media mb-6">
                    <span class="usecase-index chip">Use Case {String(index + 1).padStart(2, '0')}</span>
                    <img src={item.image} alt={`${item.title} illustration`} class="usecase-image" loading="lazy" decoding="async" />
                  </div>
                  <h3 class="card-title">{item.title}</h3>
                  <p class="card-text usecase-description">{item.description}</p>
                  <hr class="card-divider mt-auto" />
                  <p class="outcome-text mb-0">{item.outcome}</p>
                </article>
              </div>
            ))
          }
        </div>

        <div class="mt-10 flex items-center justify-center gap-3">
          <button type="button" class="swiper-button-prev usecase-button-prev carousel-nav-btn" aria-label="Previous use case">
            <svg class="fill-current" width="20" height="20" viewBox="0 0 22 22" aria-hidden="true">
              <path d="M19.25 10.24H4.57l5.85-5.94a.77.77 0 0 0-1.1-1.1L2.2 10.41a.77.77 0 0 0 0 1.1l7.12 7.22c.13.14.34.24.55.24.2 0 .38-.07.55-.2a.77.77 0 0 0 0-1.1L4.6 11.79h14.65a.76.76 0 0 0 .76-.76.78.78 0 0 0-.76-.79Z" />
            </svg>
          </button>
          <button type="button" class="swiper-button-next usecase-button-next carousel-nav-btn" aria-label="Next use case">
            <svg class="fill-current" width="20" height="20" viewBox="0 0 22 22" aria-hidden="true">
              <path d="M19.8 10.45 12.68 3.23a.77.77 0 0 0-1.1 1.1l5.78 5.88H2.75a.76.76 0 0 0-.76.76c0 .41.34.79.76.79h14.68l-5.85 5.95a.77.77 0 0 0 0 1.1c.14.13.35.2.55.2.2 0 .41-.07.55-.24l7.12-7.22a.77.77 0 0 0 0-1.1Z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .usecase-card { min-height: 520px; }

  .usecase-media {
    position: relative;
    height: 260px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background:
      radial-gradient(60% 60% at 20% 20%, rgba(123, 97, 255, 0.3), transparent 70%),
      radial-gradient(60% 60% at 85% 15%, rgba(0, 212, 255, 0.2), transparent 70%),
      var(--palette-ink-950);
  }

  .usecase-index {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 1;
    background: rgba(11, 16, 32, 0.75);
    color: #ffffff;
  }

  .usecase-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.75rem;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .usecase-card:hover .usecase-image { transform: scale(1.06); }

  .usecase-description {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 639px) {
    .usecase-card { min-height: 470px; }
    .usecase-media { height: 220px; }
  }
</style>

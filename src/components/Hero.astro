---
import './Hero.css';

const stats = [
  { value: '09+', label: 'Years of AI & Technology Expertise' },
  { value: '09', label: 'End-to-End Solution Tracks' },
  { value: '03', label: 'Core Domains: AI, Marketing, Tech' },
  { value: '04', label: 'Industry Mobile App Verticals' },
];

const capabilities = ['Agentic AI', 'MCP Servers', 'Predictive Analytics', 'Growth Marketing'];
---

<!-- ====== Hero Section Start -->
<section id="home" class="hero theme-dark-surface relative overflow-hidden">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-aurora"></div>
    <div class="grid-overlay"></div>
    <div class="hero-orb hero-orb--violet"></div>
    <div class="hero-orb hero-orb--cyan"></div>
  </div>

  <div class="container relative z-10">
    <div class="-mx-4 flex flex-wrap items-center gap-y-16">
      <div class="w-full px-4 lg:w-[55%]">
        <div class="hero-content mx-auto max-w-[680px] text-center lg:mx-0 lg:text-left">
          <span class="eyebrow">AI Integration &amp; Delivery</span>

          <h1 class="hero-title">
            Connect Your Systems to
            <span class="text-gradient">Useful AI Workflows</span>
          </h1>

          <p class="hero-subtitle">
            We design MCP integrations and agentic workflows that bring your business data and tools into practical, human-guided AI processes.
          </p>

          <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
            <a href="/contact" class="btn btn-primary btn-lg w-full sm:w-auto">
              Discuss Your Workflow <span class="btn-arrow" aria-hidden="true">→</span>
            </a>
            <a href="/#services" class="btn btn-secondary btn-lg w-full sm:w-auto">See What We Build</a>
          </div>

          <ul class="hero-capabilities" aria-label="Core capabilities">
            {capabilities.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="w-full px-4 lg:w-[45%]">
        <div class="hero-visual" aria-hidden="true">
          <div class="hero-ring hero-ring--outer"></div>
          <div class="hero-ring hero-ring--mid"></div>
          <div class="hero-ring hero-ring--inner"></div>

          <svg class="hero-network" viewBox="0 0 400 400" fill="none">
            <defs>
              <linearGradient id="heroLine" x1="0" y1="0" x2="400" y2="400" gradientUnits="userSpaceOnUse">
                <stop stop-color="#7B61FF" />
                <stop offset="1" stop-color="#00D4FF" />
              </linearGradient>
              <radialGradient id="heroCore" cx="0.5" cy="0.5" r="0.5">
                <stop stop-color="#FFFFFF" />
                <stop offset="0.35" stop-color="#B3A4FF" />
                <stop offset="1" stop-color="#6D28D9" stop-opacity="0" />
              </radialGradient>
            </defs>
            <g stroke="url(#heroLine)" stroke-width="1.2" stroke-opacity="0.55">
              <path d="M200 200 L80 110 M200 200 L320 100 M200 200 L340 250 M200 200 L250 340 M200 200 L90 300 M200 200 L60 200" />
              <path d="M80 110 L320 100 M320 100 L340 250 M340 250 L250 340 M250 340 L90 300 M90 300 L60 200 M60 200 L80 110" stroke-opacity="0.25" stroke-dasharray="4 6" />
            </g>
            <g class="hero-nodes">
              <circle cx="80" cy="110" r="6" fill="#7B61FF" />
              <circle cx="320" cy="100" r="5" fill="#00D4FF" />
              <circle cx="340" cy="250" r="7" fill="#7B61FF" />
              <circle cx="250" cy="340" r="5" fill="#00D4FF" />
              <circle cx="90" cy="300" r="6" fill="#B3A4FF" />
              <circle cx="60" cy="200" r="4" fill="#00D4FF" />
            </g>
            <circle cx="200" cy="200" r="90" fill="url(#heroCore)" opacity="0.6" />
          </svg>

          <div class="hero-core">
            <span class="hero-core-label">AI</span>
          </div>

          <div class="hero-float hero-float--a">
            <span class="hero-float-icon">⚡</span>
            <div>
              <p class="hero-float-title">Agentic Workflows</p>
              <p class="hero-float-meta"><span class="hero-live-dot"></span> Running</p>
            </div>
          </div>

          <div class="hero-float hero-float--b">
            <span class="hero-float-icon hero-float-icon--cyan">⛓</span>
            <div>
              <p class="hero-float-title">MCP Connected</p>
              <p class="hero-float-meta">CRM · Data · DevOps</p>
            </div>
          </div>

          <div class="hero-float hero-float--c">
            <p class="hero-float-meta">Delivery Model</p>
            <p class="hero-float-title">Strategy → Build → Scale</p>
            <div class="hero-progress"><span></span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-stats">
      {
        stats.map((stat) => (
          <div class="hero-stat">
            <p class="hero-stat-value">{stat.value}</p>
            <p class="hero-stat-label">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
<!-- ====== Hero Section End -->

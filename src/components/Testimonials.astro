---
const testimonials = [
  {
    authorName: 'Ananya Patel',
    authorRole: 'Chief Operations Officer, FinEdge Group',
    image: '/assets/testimonials/author-01.jpg',
    message:
      `“PAL Portals helped us move from disconnected AI pilots to one production-ready architecture. Their MCP and agentic workflow approach improved operational response time and governance at the same time.”`,
  },
  {
    authorName: 'Rohan Mehta',
    authorRole: 'VP Technology, Nova Retail Systems',
    image: '/assets/testimonials/author-02.jpg',
    message:
      `“The delivery quality was exceptional. Their team translated our business goals into a secure AI roadmap, then executed with clarity across integration, analytics, and performance optimization.”`,
  },
  {
    authorName: 'Priya Nair',
    authorRole: 'Director of Strategy, Velocity Healthcare',
    image: '/assets/testimonials/author-03.jpg',
    message:
      `“We needed enterprise-grade AI with measurable business impact. PAL Portals delivered a practical, high-standard framework that improved decision speed and reduced implementation complexity.”`,
  },
  {
    authorName: 'Arjun Malhotra',
    authorRole: 'Head of Digital Transformation, Aster Manufacturing',
    image: '/assets/testimonials/author-01.jpg',
    message:
      `“From architecture assessment to deployment readiness, their consulting brought discipline and speed to our AI program. The team combines deep technical expertise with strong business understanding.”`,
  },
  {
    authorName: 'Neha Sharma',
    authorRole: 'Senior Product Lead, Orbit SaaS Platforms',
    image: '/assets/testimonials/author-02.jpg',
    message:
      `“Their agentic AI implementation gave our product team a clear advantage. We now ship smarter automations with lower friction and stronger confidence in governance.”`,
  },
  {
    authorName: 'Kunal Desai',
    authorRole: 'CTO, Meridian Logistics Network',
    image: '/assets/testimonials/author-03.jpg',
    message:
      `“What stood out was execution excellence. Their team aligned architecture, security, and business KPIs from day one, which made our AI rollout both predictable and scalable.”`,
  },
];
---

<section id="testimonials" class="section">
  <div class="section-orb section-orb--cyan section-orb--tl" aria-hidden="true"></div>
  <div class="section-orb section-orb--violet section-orb--br" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Testimonials</span>
      <h2 class="section-title">
        Trusted by Leaders Building <span class="text-gradient">High-Impact AI</span>
      </h2>
      <p class="section-lead">
        Hear how organizations are partnering with PAL Portals to deploy secure, scalable, and outcome-driven Generative AI solutions.
      </p>
    </div>

    <div class="-m-5">
      <div class="swiper testimonial-carousel common-carousel p-5">
        <div class="swiper-wrapper">
          {
            testimonials.map((testimonial) => (
              <div class="swiper-slide">
                <figure class="glass-card glass-card--interactive testimonial-card flex flex-col">
                  <div class="mb-6 flex items-center justify-between">
                    <div class="flex gap-1 text-[#F59E0B]" role="img" aria-label="Rated 5 out of 5">
                      {[...Array(5)].map(() => (
                        <svg class="fill-current" width="18" height="16" viewBox="0 0 18 16" aria-hidden="true">
                          <path d="M8.94.36 10.95 6.06h6.5l-5.26 3.53 2.01 5.7-5.26-3.52-5.25 3.52 2-5.7L.44 6.07h6.5L8.94.36Z" />
                        </svg>
                      ))}
                    </div>
                    <svg class="testimonial-quote" width="40" height="32" viewBox="0 0 40 32" aria-hidden="true">
                      <path d="M0 32V19.2C0 8.53 5.33 2.13 16 0l1.6 4.27C11.73 5.87 9.07 9.6 8.8 14.4H16V32H0Zm24 0V19.2C24 8.53 29.33 2.13 40 0l1.6 4.27C35.73 5.87 33.07 9.6 32.8 14.4H40V32H24Z" />
                    </svg>
                  </div>

                  <blockquote class="testimonial-message card-text mb-8">{testimonial.message}</blockquote>

                  <figcaption class="mt-auto flex items-center gap-4 border-t border-[var(--color-border)] pt-5">
                    <img
                      src={testimonial.image}
                      alt=""
                      width="52"
                      height="52"
                      loading="lazy"
                      decoding="async"
                      class="testimonial-avatar"
                    />
                    <div>
                      <p class="testimonial-author mb-0">{testimonial.authorName}</p>
                      <p class="testimonial-role mb-0">{testimonial.authorRole}</p>
                    </div>
                  </figcaption>
                </figure>
              </div>
            ))
          }
        </div>

        <div class="mt-12 flex items-center justify-center gap-3">
          <button type="button" class="swiper-button-prev testimonial-button-prev carousel-nav-btn" aria-label="Previous testimonial">
            <svg class="fill-current" width="20" height="20" viewBox="0 0 22 22" aria-hidden="true">
              <path d="M19.25 10.24H4.57l5.85-5.94a.77.77 0 0 0-1.1-1.1L2.2 10.41a.77.77 0 0 0 0 1.1l7.12 7.22c.13.14.34.24.55.24.2 0 .38-.07.55-.2a.77.77 0 0 0 0-1.1L4.6 11.79h14.65a.76.76 0 0 0 .76-.76.78.78 0 0 0-.76-.79Z" />
            </svg>
          </button>
          <button type="button" class="swiper-button-next testimonial-button-next carousel-nav-btn" aria-label="Next testimonial">
            <svg class="fill-current" width="20" height="20" viewBox="0 0 22 22" aria-hidden="true">
              <path d="M19.8 10.45 12.68 3.23a.77.77 0 0 0-1.1 1.1l5.78 5.88H2.75a.76.76 0 0 0-.76.76c0 .41.34.79.76.79h14.68l-5.85 5.95a.77.77 0 0 0 0 1.1c.14.13.35.2.55.2.2 0 .41-.07.55-.24l7.12-7.22a.77.77 0 0 0 0-1.1Z" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testimonial-card {
    min-height: 340px;
    margin: 0;
  }

  .testimonial-quote {
    fill: var(--color-primary);
    opacity: 0.35;
  }

  .testimonial-message {
    margin: 0;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .testimonial-avatar {
    width: 52px;
    height: 52px;
    border-radius: 999px;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-primary);
  }

  .testimonial-author {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-text);
  }

  .testimonial-role {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
</style>

---
import { getCollection } from "astro:content";

// Filter blog entries with 'draft: false' & date before current date.
// Exclude child-level entries (nested folder slugs) to show only parent blogs.
const publishedBlogEntries = await getCollection("blog", ({ data, slug }) => {
  return !data.draft && data.publishDate < new Date() && !slug.includes("/");
});

publishedBlogEntries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<section id="blog" class="section">
  <div class="section-orb section-orb--cyan section-orb--tr" aria-hidden="true"></div>
  <div class="container">
    <div class="mb-12 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <div class="section-header section-header--left !mb-0">
        <span class="eyebrow">Our Blog</span>
        <h2 class="section-title !mb-3">
          Insights, Strategies & <span class="text-gradient">Product Intelligence</span>
        </h2>
        <p class="section-lead mb-0">
          Practical perspectives on Generative AI, MCP architecture, technology operations, and growth strategies for business leaders and delivery teams.
        </p>
      </div>
      <a href="/blog" class="btn btn-secondary shrink-0">View All Articles</a>
    </div>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        publishedBlogEntries.slice(0, 3).map((blogPostEntry, index) => (
          <li class="m-0 flex">
            <a
              class="glass-card glass-card--interactive blog-card wow flex w-full flex-col !p-4"
              data-wow-delay={`${index * 0.08}s`}
              href={`/blog/${blogPostEntry.slug}`}
            >
              <div class="blog-media mb-6">
                <img
                  src={blogPostEntry.data.image?.src || '/assets/blog/blog-default.jpg'}
                  alt={blogPostEntry.data.image?.alt || blogPostEntry.data.title}
                  loading="lazy"
                  decoding="async"
                  class="blog-media-image"
                />
                <time class="blog-date chip" datetime={blogPostEntry.data.publishDate.toISOString()}>
                  {dateFormatter.format(blogPostEntry.data.publishDate)}
                </time>
              </div>
              <div class="flex grow flex-col px-2 pb-2">
                <h3 class="blog-title card-title">{blogPostEntry.data.title}</h3>
                <p class="blog-description card-text">
                  {blogPostEntry.data.postDetails?.paraOne?.slice(0, 120) || blogPostEntry.data.snippet?.slice(0, 120) || 'Read more...'}
                </p>
                <span class="link-arrow mt-auto pt-2">Read article</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .blog-card { color: inherit; }

  .blog-media {
    position: relative;
    height: 230px;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .blog-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(6, 9, 20, 0.7));
  }

  .blog-media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .blog-card:hover .blog-media-image { transform: scale(1.07); }

  .blog-date {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    z-index: 1;
    background: rgba(11, 16, 32, 0.75);
    color: #ffffff;
    backdrop-filter: blur(8px);
  }

  .blog-title {
    transition: color var(--duration-base) ease;
  }

  .blog-card:hover .blog-title { color: var(--color-link); }

  .blog-description {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

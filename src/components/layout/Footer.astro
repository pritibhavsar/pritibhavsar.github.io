---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";

const publishedBlogEntries = await getCollection("blog", ({ data, slug }) => {
  return !slug.includes("/") && !data.draft && data.publishDate < new Date();
});

publishedBlogEntries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const footerLinks = [
  {
    header: "Company",
    links: [
      { name: "Home", href: "/" },
      { name: "About", href: "/about" },
      { name: "Testimonials", href: "/#testimonials" },
      { name: "Blog", href: "/blog" },
      { name: "Contact", href: "/contact" },
    ],
  },
  {
    header: "Capabilities",
    links: [
      { name: "End-to-End Strategy", href: "/#services" },
      { name: "Mobile App Development", href: "/#mobile-app-services" },
      { name: "Data-Driven Execution", href: "/#use-cases" },
      { name: "Expert Consulting Team", href: "/about" },
      { name: "Transparent Pricing", href: "/pricing" },
    ],
  },
  {
    header: "Offerings",
    links: [
      { name: "AI Enablement Program", href: "/#services" },
      { name: "Industry Mobile Apps", href: "/#mobile-app-services" },
      { name: "Growth Marketing Retainer", href: "/#use-cases" },
      { name: "Custom Enterprise Plan", href: "/pricing" },
      { name: "Book a Consultation", href: "/contact" },
    ],
  },
];

const socialLinks = [
  {
    name: "Facebook",
    href: "#",
    svgPath:
      "M16.294 8.86875H14.369H13.6815V8.18125V6.05V5.3625H14.369H15.8128C16.1909 5.3625 16.5003 5.0875 16.5003 4.675V1.03125C16.5003 0.653125 16.2253 0.34375 15.8128 0.34375H13.3034C10.5878 0.34375 8.69714 2.26875 8.69714 5.12187V8.1125V8.8H8.00964H5.67214C5.19089 8.8 4.74402 9.17812 4.74402 9.72812V12.2031C4.74402 12.6844 5.12214 13.1313 5.67214 13.1313H7.94089H8.62839V13.8188V20.7281C8.62839 21.2094 9.00652 21.6562 9.55652 21.6562H12.7878C12.994 21.6562 13.1659 21.5531 13.3034 21.4156C13.4409 21.2781 13.544 21.0375 13.544 20.8312V13.8531V13.1656H14.2659H15.8128C16.2596 13.1656 16.6034 12.8906 16.6721 12.4781V12.4438V12.4094L17.1534 10.0375C17.1878 9.79688 17.1534 9.52187 16.9471 9.24687C16.8784 9.075 16.569 8.90312 16.294 8.86875Z",
  },
  {
    name: "X",
    href: "#",
    svgPath:
      "M17.77 2.06h2.9l-6.34 7.24L21.78 19h-5.84l-4.57-5.97L6.15 19H3.24l6.78-7.75L2.88 2.06h5.99l4.13 5.45 4.77-5.45Zm-1.02 15.2h1.61L7.99 3.72H6.26l10.49 13.54Z",
  },
  {
    name: "Instagram",
    href: "#",
    svgPath:
      "M14.7554 1.8335H7.24463C4.25807 1.8335 1.83334 4.25823 1.83334 7.24479V14.6964C1.83334 17.7421 4.25807 20.1668 7.24463 20.1668H14.6962C17.7419 20.1668 20.1667 17.7421 20.1667 14.7555V7.24479C20.1667 4.25823 17.7419 1.8335 14.7554 1.8335ZM11.0296 15.4948C8.51614 15.4948 6.53496 13.4545 6.53496 11.0002C6.53496 8.54586 8.54571 6.50554 11.0296 6.50554C13.4839 6.50554 15.4946 8.54586 15.4946 11.0002C15.4946 13.4545 13.5134 15.4948 11.0296 15.4948ZM17.2393 6.91952C16.9436 7.24479 16.5 7.42221 15.9973 7.42221C15.5538 7.42221 15.1102 7.24479 14.7554 6.91952C14.4301 6.59425 14.2527 6.18027 14.2527 5.67758C14.2527 5.17489 14.4301 4.79049 14.7554 4.43565C15.0807 4.08081 15.4946 3.90339 15.9973 3.90339C16.4409 3.90339 16.914 4.08081 17.2393 4.40608C17.535 4.79049 17.7419 5.23403 17.7419 5.70715C17.7124 6.18027 17.535 6.59425 17.2393 6.91952Z",
  },
  {
    name: "LinkedIn",
    href: "#",
    svgPath:
      "M18.8065 1.8335H3.16399C2.42474 1.8335 1.83334 2.42489 1.83334 3.16414V18.8362C1.83334 19.5459 2.42474 20.1668 3.16399 20.1668H18.7473C19.4866 20.1668 20.078 19.5754 20.078 18.8362V3.13457C20.1371 2.42489 19.5457 1.8335 18.8065 1.8335ZM7.24464 17.4168H4.55379V8.69371H7.24464V17.4168ZM5.88443 7.48135C4.99733 7.48135 4.31721 6.77167 4.31721 5.91414C4.31721 5.05661 5.0269 4.34694 5.88443 4.34694C6.74196 4.34694 7.45163 5.05661 7.45163 5.91414C7.45163 6.77167 6.8011 7.48135 5.88443 7.48135ZM17.4463 17.4168H14.7554V13.1883C14.7554 12.183 14.7258 10.8523 13.336 10.8523C11.9167 10.8523 11.7097 11.976 11.7097 13.0996V17.4168H9.01884V8.69371H11.6506V9.90608H11.6801C12.0645 9.1964 12.9221 8.48672 14.2527 8.48672C17.0027 8.48672 17.5054 10.2609 17.5054 12.6856V17.4168H17.4463Z",
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="footer theme-dark-surface relative z-10 overflow-hidden">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="grid-overlay" aria-hidden="true"></div>

  <div class="container relative z-10 pt-20 lg:pt-24">
    <div class="grid gap-12 pb-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <a href="/" class="mb-6 inline-flex" aria-label="PAL Portals home">
          <Logo size="lg" tagline />
        </a>

        <p class="mb-6 max-w-[36ch] text-sm leading-7 md:text-base">
          Trusted AI, marketing, and technology experts delivering measurable business outcomes for growth-focused teams.
        </p>

        <a href="mailto:info@palportals.com" class="footer-email mb-8">
          <span aria-hidden="true">✉</span> info@palportals.com
        </a>

        <div class="flex flex-wrap gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.name}
              class="footer-social"
              target={social.href.startsWith("http") ? "_blank" : undefined}
              rel={social.href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              <svg viewBox="0 0 22 22" class="h-[18px] w-[18px] fill-current" aria-hidden="true">
                <path d={social.svgPath}></path>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <nav class="grid gap-8 sm:grid-cols-3 lg:col-span-5" aria-label="Footer">
        {footerLinks.map((section) => (
          <div>
            <h4 class="footer-heading">{section.header}</h4>
            <ul class="m-0 list-none space-y-3 p-0">
              {section.links.map((link) => (
                <li class="m-0">
                  <a href={link.href} class="footer-link">{link.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <div class="lg:col-span-3">
        <h4 class="footer-heading">Latest Insights</h4>
        <ul class="m-0 list-none space-y-4 p-0">
          {publishedBlogEntries.slice(0, 3).map((blogPostEntry) => (
            <li class="m-0">
              <a class="footer-post group" href={`/blog/${blogPostEntry.slug}`}>
                <div class="footer-post-thumb">
                  {blogPostEntry.data.image?.src ? (
                    <img
                      src={blogPostEntry.data.image.src}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-110"
                    />
                  ) : (
                    <span class="text-xs">BLOG</span>
                  )}
                </div>
                <span class="footer-post-title">{blogPostEntry.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="m-0 text-sm">© {currentYear} PAL Portals. All rights reserved.</p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="/privacy-policy" class="footer-meta-link">Privacy Policy</a>
        <a href="/legal-notice" class="footer-meta-link">Legal Notice</a>
        <a href="/terms-of-services" class="footer-meta-link">Terms of Services</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--palette-ink-950);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-glow {
    position: absolute;
    left: 50%;
    top: -260px;
    width: min(900px, 120vw);
    height: 420px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: radial-gradient(closest-side, rgba(123, 97, 255, 0.35), transparent);
    filter: blur(40px);
    pointer-events: none;
  }

  .footer-heading {
    margin-bottom: var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--palette-cyan-300);
  }

  .footer-social {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--palette-slate-300);
    transition: all var(--duration-base) var(--ease-out);
  }

  .footer-social:hover {
    transform: translateY(-3px);
    border-color: transparent;
    background: var(--gradient-button);
    color: #ffffff;
    box-shadow: var(--shadow-glow);
  }

  .footer-link {
    font-size: var(--fs-sm);
    color: var(--palette-slate-300);
    transition: color var(--duration-fast) ease, padding var(--duration-base) var(--ease-out);
  }

  .footer-link:hover {
    padding-left: 4px;
    color: #ffffff;
  }

  .footer-post {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .footer-post-thumb {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--palette-slate-300);
  }

  .footer-post-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--palette-slate-300);
    transition: color var(--duration-fast) ease;
  }

  .footer-post:hover .footer-post-title { color: #ffffff; }

  .footer-bottom {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--palette-slate-400);
  }

  @media (min-width: 720px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-meta-link {
    font-size: var(--fs-sm);
    color: var(--palette-slate-400);
  }

  .footer-meta-link:hover { color: #ffffff; }
</style>

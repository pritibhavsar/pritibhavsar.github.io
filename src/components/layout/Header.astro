---
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';

type MenuItem = {
  title: string;
  path: string;
  children?: Array<{ title: string; path: string }>;
};

const menuitems: MenuItem[] = [
  { title: "Services", path: "/#services" },
  { title: "Mobile Apps", path: "/#mobile-app-services" },
  { title: "About", path: "/#about" },
  { title: "Contact", path: "/#contact" },
  { title: "Blog", path: "/blog" },
];

const isActive = (path: string) => !path.includes('#') && pathname.startsWith(path);
---

<header class:list={['ud-header absolute top-0 left-0 z-40 flex w-full items-center bg-transparent', { 'ud-header--over-dark': isHome }]}>
  <div class="container">
    <div class="relative -mx-4 flex items-center justify-between">
      <div class="w-52 max-w-full px-4 sm:w-60">
        <a href="/" class="navbar-logo inline-flex py-5" aria-label="PAL Portals home">
          <Logo />
        </a>
      </div>

      <div class="flex w-full items-center justify-end px-4">
        <div class="lg:mr-4">
          <button
            id="navbarToggler"
            type="button"
            aria-label="Toggle navigation"
            aria-controls="navbarCollapse"
            class="absolute right-4 top-1/2 block -translate-y-1/2 rounded-lg px-3 py-[6px] lg:hidden"
          >
            <span class="nav-toggler-bar"></span>
            <span class="nav-toggler-bar"></span>
            <span class="nav-toggler-bar"></span>
          </button>
          <nav
            id="navbarCollapse"
            aria-label="Primary"
            class="nav-panel absolute right-4 top-full hidden w-full max-w-[280px] py-4 lg:static lg:block lg:w-auto lg:max-w-none lg:py-0"
          >
            <ul class="block lg:flex lg:items-center lg:justify-end">
              {
                menuitems.map((item) =>
                  !item.children ? (
                    <li class="group relative mb-0">
                      <a
                        href={item.path}
                        class:list={['ud-menu-scroll nav-link', { 'is-active': isActive(item.path) }]}
                        aria-current={isActive(item.path) ? 'page' : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  ) : (
                    <li class="submenu-item group relative mb-0">
                      <a href={item.path} class="nav-link items-center justify-between gap-2">
                        {item.title}
                        <svg class="fill-current" width="14" height="14" viewBox="0 0 16 20" aria-hidden="true">
                          <path d="M8 14.9c-.15 0-.28-.05-.4-.15L1.85 9.1a.55.55 0 0 1 .8-.8L8 13.53l5.35-5.28a.55.55 0 0 1 .8.8L8.4 14.7c-.13.13-.25.2-.4.2Z" />
                        </svg>
                      </a>
                      <div class="submenu glass-card relative top-full left-0 hidden w-[240px] !p-3 lg:invisible lg:absolute lg:top-[110%] lg:block lg:opacity-0 lg:group-hover:visible lg:group-hover:top-full lg:group-hover:opacity-100">
                        {item.children.map((child) => (
                          <a href={child.path} class="block rounded-lg px-4 py-2 text-sm">
                            {child.title}
                          </a>
                        ))}
                      </div>
                    </li>
                  )
                )
              }
            </ul>
            <div class="px-6 pt-3 lg:hidden">
              <a href="/contact" class="btn btn-primary btn-sm w-full">Let's Talk</a>
            </div>
          </nav>
        </div>

        <div class="flex items-center gap-3 pr-14 lg:pr-0">
          <button class="icon-btn" id="themeSwitcher" type="button" aria-label="Toggle color theme">
            <span class="hidden dark:block" aria-hidden="true">
              <svg class="fill-current" width="20" height="20" viewBox="0 0 24 24">
                <path d="M12 6.9a5.1 5.1 0 1 0 0 10.2 5.1 5.1 0 0 0 0-10.2Zm0 8.51a3.41 3.41 0 1 1 0-6.82 3.41 3.41 0 0 1 0 6.82ZM12 4.24c.45 0 .86-.38.86-.86V1.5a.86.86 0 0 0-1.72 0v1.91c.04.45.41.83.86.83Zm0 15.52c-.45 0-.86.38-.86.86v1.88a.86.86 0 0 0 1.72 0v-1.91c0-.45-.41-.83-.86-.83Zm6.11-13.01c.23 0 .45-.08.6-.26l1.2-1.2a.84.84 0 0 0-1.2-1.2l-1.2 1.2a.84.84 0 0 0 .6 1.46ZM5.33 17.51l-1.2 1.17a.84.84 0 0 0 .6 1.46c.22 0 .45-.08.6-.26l1.2-1.2a.84.84 0 0 0-1.2-1.17ZM22.5 11.18h-1.91a.86.86 0 0 0 0 1.72h1.91a.86.86 0 0 0 0-1.72ZM4.24 12a.86.86 0 0 0-.86-.86H1.5a.86.86 0 0 0 0 1.72h1.91c.45 0 .83-.41.83-.86Zm14.43 5.51a.84.84 0 0 0-1.2 1.2l1.2 1.2c.15.15.38.26.6.26.23 0 .45-.07.6-.26a.84.84 0 0 0 0-1.2l-1.2-1.2ZM5.33 4.13a.84.84 0 0 0-1.2 1.2l1.2 1.2c.15.15.37.26.6.26.22 0 .45-.08.6-.26a.84.84 0 0 0 0-1.2l-1.2-1.2Z" />
              </svg>
            </span>
            <span class="block dark:hidden" aria-hidden="true">
              <svg class="fill-current" width="20" height="20" viewBox="0 0 24 24">
                <path d="M13.31 1.5a11 11 0 0 0-1.95-.45 1.03 1.03 0 0 0-.94 1.95c2.66 2.48 3.64 6.11 2.55 9.53a8.92 8.92 0 0 1-8.81 6.56c-.53 0-.94.34-1.09.83-.15.48.08 1.01.49 1.27.94.57 1.88 1.01 2.82 1.31 1.09.34 2.21.49 3.34.49 1.91 0 3.79-.49 5.47-1.43a11.17 11.17 0 0 0 5.36-6.68A11.3 11.3 0 0 0 13.31 1.5Z" />
              </svg>
            </span>
          </button>
          <a href="/contact" class="btn btn-primary btn-sm hidden sm:inline-flex">
            Let's Talk <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  @media (max-width: 959px) {
    .nav-panel {
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-lg);
      background: var(--color-glass-strong);
      backdrop-filter: blur(18px);
      box-shadow: var(--shadow-lg);
    }
  }

  .submenu a { color: var(--color-text-secondary); }
  .submenu a:hover { background: var(--color-primary-soft); color: var(--color-text); }
</style>

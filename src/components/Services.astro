const serviceMetrics = [
  { value: '3', label: 'Core Expertise Domains', detail: 'Generative AI, Marketing, Technology' },
  { value: '9', label: 'Solution Tracks', detail: 'From strategy, build, integration, and scale' },
  { value: 'End-to-End', label: 'Delivery Model', detail: 'Advisory, implementation, and optimization' }

---

<!-- ====== Services Section Start -->
<section id="services" class="section">
  <div class="section-orb section-orb--violet section-orb--tl" aria-hidden="true"></div>
  <div class="section-orb section-orb--cyan section-orb--br" aria-hidden="true"></div>
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">AI, Marketing & Technology Solutioning</span>
      <h2 class="section-title">
        Services That Turn Expertise Into <span class="text-gradient">Business Growth</span>
      </h2>
      <p class="section-lead">
        We deliver outcome-focused offerings across Generative AI, modern marketing systems, and advanced technology consulting to help teams scale with confidence.
      </p>
    </div>

    <div class="mb-12 grid grid-cols-1 gap-4 md:grid-cols-3 lg:mb-16">
      {
        serviceMetrics.map((metric) => (
          <div class="metric-card">
            <p class="metric-value">{metric.value}</p>
            <p class="metric-label">{metric.label}</p>
            <p class="metric-detail">{metric.detail}</p>
          </div>
        ))
      }
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service, index) => (
          <article class="glass-card glass-card--interactive wow flex flex-col" data-wow-delay={`${(index % 3) * 0.08}s`}>
            <div class="mb-6 flex items-start justify-between gap-3">
              <span class="icon-tile">
                <img src={service.icon} alt="" loading="lazy" decoding="async" />
              </span>
              <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
            </div>

            <span class="chip mb-4 self-start">{service.category}</span>
            <h3 class="card-title">{service.title}</h3>
            <p class="card-text mb-0">{service.description}</p>

            <hr class="card-divider mt-auto" />
            <p class="outcome-text mb-5">{service.impact}</p>

            <a href={service.ref} class="link-arrow" aria-label={`${service.refTitle}: ${service.title}`}>
              {service.refTitle}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
<!-- ====== Services Section End -->
